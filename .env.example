# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Create a bot with @BotFather on Telegram to get a token like:
#   123456789:AAHz9k1abcDEfGhiJKlmNoPQRstuVWxyz12
TELEGRAM_BOT_TOKEN=

# The chat/channel/user ID the bot should post to. For a personal chat,
# message your bot once and check https://api.telegram.org/bot<token>/getUpdates
# for the numeric "chat":{"id": ...} value.
TELEGRAM_CHAT_ID=
