# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Create a bot with @BotFather on Telegram to get a token like:
#   123456789:AAHz9k1abcDEfGhiJKlmNoPQRstuVWxyz12
TELEGRAM_BOT_TOKEN=

# The chat/channel/user ID the bot should post to. For a personal chat,
# message your bot once and check https://api.telegram.org/bot<token>/getUpdates
# for the numeric "chat":{"id": ...} value.
TELEGRAM_CHAT_ID=

# Local Ollama server (https://ollama.com) used by scripts/analyze_pending_ipos.py.
# Not a secret, but kept alongside the other runtime config here.
OLLAMA_BASE_URL=http://localhost:11434

# Required — no default model is assumed. Must already be pulled locally
# (`ollama pull <model>`, then `ollama list` to see exact names/tags).
OLLAMA_MODEL=

# Local generation can be slow, especially on CPU — default 180s.
OLLAMA_TIMEOUT_SECONDS=180
