# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Create a bot with @BotFather on Telegram to get a token like:
#   123456789:AAHz9k1abcDEfGhiJKlmNoPQRstuVWxyz12
TELEGRAM_BOT_TOKEN=

# The chat/channel/user ID the bot should post to. For a personal chat,
# message your bot once and check https://api.telegram.org/bot<token>/getUpdates
# for the numeric "chat":{"id": ...} value.
TELEGRAM_CHAT_ID=

# Gemini API (https://aistudio.google.com/apikey) used by
# scripts/analyze_pending_ipos.py. This IS a secret — never commit a
# real value. In GitHub Actions it's supplied via the GEMINI_API_KEY
# repository secret instead of this file.
GEMINI_API_KEY=

# Defaults to gemini-3.5-flash if unset.
GEMINI_MODEL=gemini-3.5-flash

# Defaults to 120s if unset.
GEMINI_TIMEOUT_SECONDS=120

# Local OCR fallback for scanned/empty KAP PDFs, used by
# scripts/fetch_kap_disclosures.py --ocr-scanned (halka_arz_advisor.kap.ocr).
# Requires the Tesseract CLI with the Turkish + English language packs
# (macOS: `brew install tesseract tesseract-lang`; Debian/Ubuntu/CI:
# `apt-get install tesseract-ocr tesseract-ocr-tur tesseract-ocr-eng`).
# Not a secret. A digitally-readable PDF never touches OCR regardless
# of this setting.
OCR_ENABLED=true

# Render resolution in DPI — higher improves recognition accuracy on
# small text at the cost of slower rendering/OCR.
OCR_DPI=220

# A scanned document longer than this many pages is only OCR'd up to
# the limit, and the result is marked ocr_partial rather than presented
# as complete.
OCR_MAX_PAGES=30

# Per-page Tesseract timeout.
OCR_TIMEOUT_SECONDS=60
